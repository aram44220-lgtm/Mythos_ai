# ============================================================
# General / Default AI Configuration (OpenRouter)
# Get a key from: https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Server Port and Host
PORT=8000
HOST=127.0.0.1

# ============================================================
# DEVIL / DEMON — Uncensored AI API Configuration
# Настройки для Дьявола / Без цензуры (опционально)
# ============================================================

# Отдельный API ключ для дьявола (если пустой — использует OPENROUTER_API_KEY)
DEVIL_API_KEY=

# Uncensored модель для дьявола (на OpenRouter или другом провайдере):
# Рекомендуемые модели без цензуры:
#  - cognitivecomputations/dolphin-mixtral-8x7b
#  - nousresearch/nous-hermes-2-mixtral-8x7b-dpo
#  - nousresearch/hermes-3-llama-3.1-405b
#  - mistralai/mistral-large-2407
#  - meta-llama/llama-3.3-70b-instruct
#  - google/gemini-2.5-flash (быстро и остроумно)
DEVIL_MODEL=google/gemini-2.5-flash

# Базовый URL API провайдера (по умолчанию — OpenRouter)
# Если используешь сторонний uncensored сервис (Venice.ai, Together AI, Featherless, Ollama):
#  - OpenRouter:  https://openrouter.ai/api/v1/chat/completions
#  - Venice.ai:   https://api.venice.ai/api/v1/chat/completions
#  - Together AI: https://api.together.xyz/v1/chat/completions
#  - Локальная Ollama: http://localhost:11434/v1/chat/completions
DEVIL_BASE_URL=https://openrouter.ai/api/v1/chat/completions
